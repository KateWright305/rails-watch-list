<div class="container">
  <div class="card header-card">
    <div class="card-body">
      <h1><%= @list.name %></h1>
    </div>
  </div>
</div>

<main>
  <div class = "container">
    <div class="row">
      <% @list.bookmarks.each do |bookmark| %>
        <div class="col-sm-3">
          <div class="card movie-card">
            <%= image_tag "", class: "card-img", alt: "" %>
            <div class="card-body">
              <h5><strong><%= bookmark.movie.title %></strong></h5>
              <p><%= bookmark.movie.overview %></p>
            </div>
            <ul class="list-group list-group-flush">
              <li class="list-group-item"><%= bookmark.movie.rating %><i class="fa-solid fa-star ms-2"></i></li>
              <li class="list-group-item"><i class="fa-solid fa-quote-left me-2"></i><%= bookmark.comment %><i class="fa-solid fa-quote-right ms-2"></i></li>
            </ul>
            <div class="card-body">
              <%= link_to "Delete", bookmark_path(bookmark), data: {turbo_method: :delete, turbo_confirm: "Are you sure?"} %>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="row row-cols-auto">
      <div class="col">
        <%= link_to "Bookmark a film", new_list_bookmark_path(@list), class:"btn btn-warning" %>
      </div>
      <div class="col">
        <%= link_to "Back to lists", lists_path, class:"btn btn-outline-secondary" %>
      </div>
    </div>
  </div>
</main>
