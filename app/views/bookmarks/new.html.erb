<div class="container">
  <div class="card header-card">
    <div class="card-body">
      <h1>Add a new bookmark</h1>
    </div>
  </div>
</div>


<main>
  <div class="container">
    <%= simple_form_for [@list, @bookmark] do |f| %>
      <%= f.input :comment %>
      <%= f.association :movie %>

      <div class="d-flex gap-2">
        <%= f.button :submit, class:"btn btn-warning" %>
        <%= link_to "Back to list", list_path(@list), class:"btn btn-outline-secondary" %>
      </div>
    <% end %>
  </div>
</main>
